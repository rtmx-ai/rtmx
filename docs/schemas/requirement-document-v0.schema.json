{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtmx.ai/schemas/requirement-document-v0.schema.json",
  "title": "RTMX Requirement Document Model v0 (REQ-DATA-001a spike)",
  "description": "Logical document shape for AC-to-test ATDD. On-disk encoding is TBD (REQ-DATA-001f). Does not change production CSV defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirements"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "requirement-document/v0"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Requirement" }
    }
  },
  "$defs": {
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["req_id", "requirement_text", "status", "priority", "acs"],
      "properties": {
        "req_id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9]+-[0-9]+[a-z]?$",
          "description": "Stable requirement identity (CSV req_id)."
        },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "requirement_text": { "type": "string", "minLength": 1 },
        "target_value": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["MISSING", "PARTIAL", "COMPLETE", "NOT_STARTED", "BLOCKED"]
        },
        "priority": { "type": "string" },
        "phase": { "type": ["integer", "string"] },
        "effort_weeks": { "type": "number" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external_id": { "type": "string" },
        "requirement_file": {
          "type": "string",
          "description": "Optional narrative companion path (Markdown)."
        },
        "narrative": {
          "type": "string",
          "description": "Optional embedded prose; encoding TBD."
        },
        "acs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AcceptanceCriterion" }
        },
        "test_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestBinding" }
        }
      }
    },
    "AcceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ac_id", "statement"],
      "properties": {
        "ac_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable AC identity within a requirement. Scheme: ordinal AC-N for a fixed statement text; rematerialization must reuse the same ac_id when statement text is unchanged (content-hash policy deferred)."
        },
        "statement": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": true },
        "severity": {
          "type": "string",
          "enum": ["must", "should", "may"]
        }
      }
    },
    "TestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id"],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "ac_id": {
          "type": "string",
          "description": "When set, evidence applies to this AC."
        },
        "req_id": {
          "type": "string",
          "description": "Optional requirement-level binding."
        },
        "test_module": { "type": "string" },
        "test_function": { "type": "string" },
        "marker": { "type": "string" },
        "notes": { "type": "string" }
      },
      "anyOf": [
        { "required": ["ac_id"] },
        { "required": ["req_id"] }
      ]
    }
  }
}
