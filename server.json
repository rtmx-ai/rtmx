{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rtmx-ai/rtmx",
  "title": "RTMX",
  "description": "Git-native requirements RTM for agents (next, claim, verify) — not another Jira/Linear MCP. Launch: rtmx mcp-server --stdio (rtmx on PATH via brew or npm).",
  "repository": {
    "url": "https://github.com/rtmx-ai/rtmx",
    "source": "github"
  },
  "version": "1.9.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "rtmx",
      "version": "0.3.0",
      "registryBaseUrl": "https://registry.npmjs.org",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp-server"
        },
        {
          "type": "positional",
          "value": "--stdio"
        }
      ]
    }
  ]
}
